# ========== DATABASE ==========
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=workshop_manager

# ========== SERVER ==========
PORT=5000

# ========== JWT & AUTH ==========
JWT_SECRET=your_jwt_secret_key_change_me

# ========== CORS & DEPLOYMENT ==========
# For development with frontend on same server
FRONTEND_URL=http://localhost:3000

# For production (set to actual frontend domain)
# FRONTEND_URL=https://yourdomain.com

# Allow all origins (USE ONLY FOR DEVELOPMENT!)
# ALLOW_ALL_ORIGINS=false

# ========== CLOUDINARY (Image Storage) ==========
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ========== LICENSE SERVER ==========
LICENSE_SERVER_URL=http://localhost:4000

# ========== NODE ENVIRONMENT ==========
NODE_ENV=development
